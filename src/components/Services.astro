---
import { Image } from 'astro:assets';
import { services } from '../data/services';
const tone = { frio: 'text-frio-tinta', calor: 'text-calor-tinta', obra: 'text-tinta-2' } as const;
---
<section id="servicios" aria-labelledby="servicios-t" class="border-b border-linea bg-white">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="servicios-t" class="cond text-[clamp(2.75rem,7vw,5.5rem)]">Lo que hacemos</h2>
      <p class="max-w-md text-tinta-2">Empezamos como instaladores de climatización. Hoy coordinamos obras completas con oficiales de cada gremio.</p>
    </div>

    <ol class="mt-14 divide-y divide-linea border-y border-linea">
      {services.map((s, i) => (
        <li id={`servicio-${s.id}`} data-servicio={s.id} class="group relative grid gap-8 py-10 transition-colors data-[activo]:bg-hielo md:grid-cols-12 md:gap-10 md:py-12">
          <span class="absolute inset-y-0 left-0 w-1 origin-top scale-y-0 temp-bg transition-transform duration-300 group-data-[activo]:scale-y-100" aria-hidden="true"></span>
          <div class="md:col-span-5 md:pl-6">
            <p class:list={['kicker', tone[s.id]]}>{String(i + 1).padStart(2, '0')} · {s.kicker}</p>
            <h3 class="cond mt-3 text-[clamp(2.25rem,4.5vw,3.5rem)]">{s.title}</h3>
            <p class="mt-4 text-lg text-tinta-2">{s.lead}</p>
            <ul class="mt-6 grid gap-x-6 gap-y-2 sm:grid-cols-2">
              {s.items.map((it) => (
                <li class="flex items-baseline gap-2 border-t border-linea pt-2"><span class:list={['font-semibold', tone[s.id]]} aria-hidden="true">—</span>{it}</li>
              ))}
            </ul>
          </div>
          <div class:list={['md:col-span-7', i % 2 === 1 && 'md:order-first']}>
            <Image src={s.img} alt={s.alt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 55vw, 100vw" class="aspect-[16/10] w-full rounded-2xl object-cover" loading="lazy" />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
