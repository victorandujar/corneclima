---
import { Image } from 'astro:assets';
import { services } from '../data/services';
const tone = { frio: 'text-frio-tinta', calor: 'text-calor-tinta', obra: 'text-tinta-2' } as const;
const glow = { frio: 'var(--color-frio)', calor: 'var(--color-calor)', obra: '#8a4dff' } as const;
---
<section id="servicios" aria-labelledby="servicios-t" class="border-b border-linea bg-white">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="servicios-t" class="cond text-[clamp(3rem,8vw,6.5rem)]" data-reveal>Lo que<br />hacemos</h2>
      <p class="max-w-md text-lg text-tinta-2" data-reveal style="--i:1">Empezamos como instaladores de climatización. Hoy coordinamos obras completas con oficiales de cada gremio.</p>
    </div>

    <ol class="mt-16 grid gap-20 md:gap-28">
      {services.map((s, i) => (
        <li id={`servicio-${s.id}`} data-servicio={s.id} class="group relative grid items-center gap-8 md:grid-cols-12 md:gap-12">
          <div class:list={['relative md:col-span-7', i % 2 === 1 && 'md:order-last']}>
            <div class="absolute -inset-4 -z-10 rounded-[2rem] opacity-0 blur-2xl transition-opacity duration-500 group-data-[activo]:opacity-60" style={`background:${glow[s.id]}`} aria-hidden="true"></div>
            <div class="overflow-hidden rounded-2xl" data-reveal="clip">
              <Image src={s.img} alt={s.alt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[16/11] w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.04]" loading="lazy" />
            </div>
            <span class="cond pointer-events-none absolute -top-16 -z-[5] text-[9rem] leading-none text-tinta/[0.07] sm:-top-28 sm:text-[13rem]" class:list={[i % 2 === 1 ? 'right-2' : 'left-2']} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="md:col-span-5">
            <p class:list={['kicker inline-flex items-center gap-2', tone[s.id]]} data-reveal>
              <span class="h-2 w-2 rounded-full" style={`background:${glow[s.id]}`} aria-hidden="true"></span>{String(i + 1).padStart(2, '0')} · {s.kicker}
              <span class="kicker ml-2 hidden rounded-full bg-tinta px-2.5 py-0.5 text-[0.7rem] text-white group-data-[activo]:inline">Recomendado</span>
            </p>
            <h3 class="cond mt-3 text-[clamp(2.5rem,5vw,4rem)]" data-reveal style="--i:1">{s.title}</h3>
            <p class="mt-4 text-lg text-tinta-2" data-reveal style="--i:2">{s.lead}</p>
            <ul class="mt-6 grid gap-x-6 sm:grid-cols-2">
              {s.items.map((it, k) => (
                <li class="flex items-baseline gap-2 border-t border-linea py-2.5" data-reveal style={`--i:${3 + k}`}><span class:list={['font-semibold', tone[s.id]]} aria-hidden="true">—</span>{it}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
