---
import Logo from './Logo.astro';
import { business, telUrl } from '../data/business';
const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#trabajos', label: 'Trabajos' },
  { href: '#financiacion', label: 'Financiación' },
  { href: '#contacto', label: 'Contacto' },
];
const tel = business.phones[0];
---
<header class="on-dark sticky top-0 z-40 border-b border-white/10 bg-noche/85 text-white backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-6 px-4 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 text-frio">
      <Logo variant="llama" class="h-8" />
      <span class="cond text-[1.6rem] tracking-wide text-white">Corneclima</span>
      <span class="sr-only">(inicio)</span>
    </a>
    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {links.map((l) => <li><a href={l.href} class="kicker py-2 text-white/80 hover:text-white">{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-4">
      <a href={telUrl(tel.e164)} class="kicker hidden tabular-nums md:inline">{tel.display}</a>
      <a href="#contacto" class="btn min-h-10 bg-white py-1.5 text-tinta hover:bg-[var(--temp)]">Presupuesto</a>
    </div>
  </div>
</header>
