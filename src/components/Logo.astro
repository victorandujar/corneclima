---
import llama from '../assets/brand/llama.svg?raw';
import completo from '../assets/brand/logo-completo.svg?raw';
interface Props { variant: 'llama' | 'completo'; class?: string }
const { variant, class: cls = '' } = Astro.props;
const svg = { llama, completo }[variant].replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<span class:list={['inline-block [&>svg]:h-full [&>svg]:w-auto', cls]} set:html={svg} />
