<section id="financiacion" aria-labelledby="fin-t" class="on-dark relative overflow-hidden border-b border-white/10 bg-noche text-white">
  <div class="absolute inset-x-0 top-0 h-1.5" style="background: linear-gradient(90deg, var(--color-frio), #3b6cff 30%, #8a4dff 50%, #e0457b 72%, var(--color-calor));" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-[90rem] items-center gap-8 px-4 py-16 sm:px-8 md:grid-cols-12 md:py-20">
    <p class="cond bg-clip-text text-[clamp(6rem,18vw,14rem)] leading-[0.8] text-transparent md:col-span-5" style="background-image: linear-gradient(100deg, var(--color-frio), #3b6cff 35%, #8a4dff 55%, #e0457b 75%, var(--color-calor));" aria-hidden="true">24<span class="block text-[0.3em] leading-none">meses</span></p>
    <div class="md:col-span-7">
      <h2 id="fin-t" class="cond text-[clamp(2.25rem,5vw,3.75rem)]">Financiación hasta 24 meses sin intereses</h2>
      <p class="mt-4 max-w-xl text-lg text-white/80">Para tu caldera, tu aire acondicionado o la reforma de casa: cualquier proyecto que hagamos.</p>
      <a href="#contacto" class="btn mt-8 bg-white text-tinta hover:bg-frio">Consultar financiación</a>
    </div>
  </div>
</section>
