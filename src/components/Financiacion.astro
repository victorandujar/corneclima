---
---
<section id="financiacion" aria-labelledby="fin-t" class="on-dark relative overflow-hidden border-b border-white/10 bg-noche text-white">
  <div class="absolute inset-x-0 top-0 h-1.5" style="background: linear-gradient(90deg, var(--color-frio), #3b6cff 30%, #8a4dff 50%, #e0457b 72%, var(--color-calor));" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-40 top-1/2 h-[40rem] w-[40rem] -translate-y-1/2 rounded-full opacity-40 blur-3xl" style="background: radial-gradient(closest-side, #8a4dff, transparent);" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-[90rem] items-center gap-8 px-4 py-20 sm:px-8 md:grid-cols-12 md:py-28">
    <p class="cond bg-clip-text text-[clamp(7rem,20vw,16rem)] leading-[0.8] text-transparent tabular-nums md:col-span-5" style="background-image: linear-gradient(100deg, var(--color-frio), #3b6cff 35%, #8a4dff 55%, #e0457b 75%, var(--color-calor));" aria-hidden="true" data-reveal data-count="24">24<span class="block text-[0.28em] leading-none">meses</span></p>
    <div class="md:col-span-7">
      <h2 id="fin-t" class="cond text-[clamp(2.5rem,5.5vw,4.25rem)]" data-reveal style="--i:1">Financiación hasta 24 meses sin intereses</h2>
      <p class="mt-4 max-w-xl text-lg text-white/80" data-reveal style="--i:2">Para tu caldera, tu aire acondicionado o la reforma de casa: cualquier proyecto que hagamos.</p>
      <a href="#contacto" class="btn mt-8 bg-white text-tinta hover:bg-frio" data-reveal style="--i:3">Consultar financiación</a>
    </div>
  </div>
</section>

<script>
  // Cuenta 0 → 24 la primera vez que aparece (sin movimiento reducido).
  const el = document.querySelector<HTMLElement>('[data-count]');
  const node = el?.firstChild;
  if (el && node && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const target = Number(el.dataset.count);
    node.textContent = '0';
    el.addEventListener('reveal', () => {
      const t0 = performance.now();
      const step = (now: number): void => {
        const p = Math.min(1, (now - t0) / 1100);
        node.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, { once: true });
  }
</script>
